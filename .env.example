# Скопируйте этот файл в .env и заполните своими значениями.
# .env не должен попадать в git (см. .gitignore).

# Токен бота, полученный у @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Telegram ID админов через запятую
ADMIN_IDS=111111111,222222222

# Строка подключения к PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/pinsk_urbex

# Название города — используется в текстах бота
CITY_NAME=Пинск
