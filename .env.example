# Токен боевого бота, полученный у @BotFather
BOT_TOKEN=

# Токен второго бота — для локального теста (BOT_TOKEN должен быть пуст)
BETA_BOT_TOKEN=

# Telegram ID админов через запятую
ADMIN_IDS=111111111,222222222

# Строка подключения к PostgreSQL — обязательна в обоих режимах: в боевом
# это основная база бота, в бета-режиме — источник, из которого при каждом
# локальном запуске подтягивается снимок.
DATABASE_URL=postgresql://user:password@localhost:5432/pinsk_urbex

# --- Шифрование персональных данных (0.4) -----------------------------------
# telegram_id, username, full_name и приватные заметки админов хранятся в БД
# только в зашифрованном виде (см. utils/crypto.py). Обязателен в обоих
# режимах — сгенерируйте случайный:
#     python -m scripts.generate_secret_key
# и вставьте результат сюда. То же значение должно быть и в боевом, и в
# бета-режиме: бета-бот подтягивает снимок прода как есть, зашифрованными
# байтами, без расшифровки — расшифровать их локально сможет только тот же
# ключ, которым их зашифровал боевой бот. Потеря ключа делает все
# зашифрованные данные в БД навсегда нечитаемыми — храните резервную копию
# отдельно от .env и БД.
APP_SECRET_KEY=

# Название города — используется в текстах бота
CITY_NAME=Пинск

# Ссылка на GitHub-репозиторий проекта — опционально, используется командой /about.
GITHUB_REPO_URL=https://github.com/Maxicus0/PinskUrbexBot
